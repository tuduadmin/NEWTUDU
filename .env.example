# Unlisted Control Room sign-in URL (production). Example: /staff/access-8f3k2
# When set in production builds, /admin/signin is not registered — share this path only by email.
# VITE_CONTROL_ROOM_SIGN_IN_PATH=/staff/access-8f3k2

# ── Stripe (client) ─────────────────────────────────────────────
# From Stripe Dashboard → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Base URL for your payments API (Supabase Edge Functions, Node, etc.)
# Must expose POST /checkout/session → { "url": "https://checkout.stripe.com/..." }
VITE_PAYMENTS_API_URL=https://your-api.example.com

# ── Stripe (server only — never prefix with VITE_) ─────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Map Stripe Price IDs (create in Dashboard → Products)
# STRIPE_PRICE_EXPLORER_MONTHLY=price_...
# STRIPE_PRICE_EXPLORER_ANNUAL=price_...
# STRIPE_PRICE_PIONEER_MONTHLY=price_...
# STRIPE_PRICE_PIONEER_ANNUAL=price_...
# STRIPE_PRICE_TRUSTED_MONTHLY=price_...
# STRIPE_PRICE_TRUSTED_ANNUAL=price_...
# STRIPE_PRICE_HIDDEN_GEM_1=price_...
# STRIPE_PRICE_HIDDEN_GEM_3=price_...
# STRIPE_PRICE_EXTRA_EVENT_1=price_...
# STRIPE_PRICE_EXTRA_EVENT_5=price_...
